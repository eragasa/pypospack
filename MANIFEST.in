include LICENSE
include MANIFEST.in
include OFFLINE_ARTIFACTS.md
include OFFLINE_ARTIFACT_SHA256SUMS
include README.rst
include pyproject.toml
include requirements.txt
include setup.py
recursive-include docs *.md
recursive-include pypospack *.py
recursive-include release_tests *.py
recursive-include tools *.py
prune .offline
prune data
prune dev
prune examples
prune src
prune tests
prune tests_old
prune visualization_apps
global-exclude *.py[cod]
global-exclude __pycache__
